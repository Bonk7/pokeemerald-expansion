raw `
EverGrandeCity_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, EverGrandeCity_OnTransition
	.byte 0

EverGrandeCity_OnTransition:
	call_if_set FLAG_SYS_WEATHER_CTRL, Common_EventScript_SetAbnormalWeather
	end

EverGrandeCity_EventScript_VictoryRoadSign::
	msgbox EverGrandeCity_Text_EnteringVictoryRoad, MSGBOX_SIGN
	end

EverGrandeCity_EventScript_CitySign::
	msgbox EverGrandeCity_Text_CitySign, MSGBOX_SIGN
	end

EverGrandeCity_EventScript_PokemonLeagueSign::
	msgbox EverGrandeCity_Text_EnteringPokemonLeague, MSGBOX_SIGN
	end

EverGrandeCity_EventScript_SetVisitedEverGrande::
	setflag FLAG_VISITED_EVER_GRANDE_CITY
	setvar VAR_TEMP_1, 1
	end

EverGrandeCity_Text_EnteringVictoryRoad:
	.string "ENTERING VICTORY ROAD$"

EverGrandeCity_Text_EnteringPokemonLeague:
	.string "ENTERING POKéMON LEAGUE\n"
	.string "CENTER GATE$"

EverGrandeCity_Text_CitySign:
	.string "EVER GRANDE CITY\p"
	.string "“The paradise of flowers, the sea,\n"
	.string "and POKéMON.”$"

`

script EGC_Eventscript_BattleIlse {
    trainerbattle_single(TRAINER_ILSE_EGC, "Hey my name is Ilse,\n and i will beat you!", "Ah.. you are so lucky!", EGC_GIVEMEWTWO)
	msgbox(format("Behind Victory Road lies the \nPokemon League!\p I think you can defeat the champion!"), MSGBOX_NPC)
	end
}	

script EGC_GIVEMEWTWO
{
	setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_MEWTWO_MEGA_Y)
	givemon(SPECIES_MEWTWO_MEGA_Y, 90, ITEM_LIFE_ORB, ITEM_LOVE_BALL, NATURE_MODEST,,,,,,,,,31,31,31,31,31,31, MOVE_PSYSTRIKE, MOVE_SHADOW_BALL, MOVE_THUNDERBOLT, MOVE_ICE_BEAM, TRUE )	
	if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY) {
		goto(EGC_GIVEMEWTWO_PARTY)
	}
	if(var(VAR_RESULT) == MON_GIVEN_TO_PC) {
		goto(EGC_GIVEMEWTWO_PC)
	}
	goto(Common_EventScript_NoMoreRoomForPokemon)

EGC_GIVEMEWTWO_PARTY:
	msgbox("Mewtwo wants to help you.\nPlease take good care of him.", MSGBOX_AUTOCLOSE)
	showmonpic(SPECIES_MEWTWO_MEGA_Y, 0, 0)
	msgbox("Give Mewtwo a nickname?", MSGBOX_YESNO)
	hidemonpic
	if(var(VAR_RESULT) == NO) {
		goto(EGC_GIVEMEWTWO_DONE)
	}
	call(Common_EventScript_GetGiftMonPartySlot)
	call(Common_EventScript_NameReceivedPartyMon)
	goto(EGC_GIVEMEWTWO_DONE)

EGC_GIVEMEWTWO_PC:
	msgbox("Mewtwo wants to help you.\nPlease take good care of him.", MSGBOX_AUTOCLOSE)
	showmonpic(SPECIES_MEWTWO_MEGA_Y, 0, 0)
	msgbox("Give Mewtwo a nickname?", MSGBOX_YESNO)
	hidemonpic
	if(var(VAR_RESULT) == NO) {
		goto(EGC_GIVEMEWTWO_TRANSFERRED)
	}
	call(Common_EventScript_NameReceivedBoxMon)
	goto(EGC_GIVEMEWTWO_TRANSFERRED)

EGC_GIVEMEWTWO_TRANSFERRED:
	call(Common_EventScript_TransferredToPC)
	goto(EGC_GIVEMEWTWO_DONE)

EGC_GIVEMEWTWO_DONE:
	end
}

script BattleFrankAfterChampion{
	if(flag(FLAG_IS_CHAMPION) == TRUE) {
		trainerbattle_single(TRAINER_FRANK_EGC, "I am so proud of you!\nYou are the best trainer in the world!\nThat is... if i did not exit\n Now it is time for your final test!\p I won't hold back", "Will you...", MSGBOX_AUTOCLOSE)
		do {
			msgbox("{PLAYER}, will you marry me?", MSGBOX_YESNO)
		} while (var(VAR_RESULT) == NO)
		giveitem(ITEM_SWEET_HEART)
		giveitem(ITEM_HEART_SCALE)
		msgbox("These items represent the love\nwe share. The heart symbol shows\nthat love will always connect us.", MSGBOX_AUTOCLOSE)
	}
	elif (flag(FLAG_IS_CHAMPION) == FALSE) {
		msgbox("Talk to me when \nyou have become the champion!", MSGBOX_AUTOCLOSE)
	}
}
